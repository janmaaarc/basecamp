#!/usr/bin/env bash
# Regenerates AGENTS.md from CLAUDE.md so Codex and Claude Code read the same rules.
#
# CLAUDE.md pulls in rules with `@file.md` lines, which Claude Code resolves and Codex does
# not. Flattening those imports is the whole job. Keeping AGENTS.md as a hand-made copy was
# the failure mode this replaces: it drifts the moment CLAUDE.md changes.
#
# Usage: basecamp-sync-agents [source CLAUDE.md] [output AGENTS.md]

set -euo pipefail

SRC="${1:-$HOME/.claude/CLAUDE.md}"
OUT="${2:-$HOME/.codex/AGENTS.md}"

[ -f "$SRC" ] || { echo "No such file: $SRC" >&2; exit 1; }
mkdir -p "$(dirname "$OUT")"

{
  echo "<!-- Generated by basecamp-sync-agents from ${SRC/#$HOME/~}. Edit that file, not this one. -->"
  echo
  # `|| [ -n "$line" ]` keeps the last line when the file has no trailing newline, which read
  # otherwise drops silently. Stripping \r keeps CRLF checkouts from turning an @import into a
  # path that does not exist, which would emit the raw @line instead of the rule content.
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case "$line" in
      @*)
        imported="$(dirname "$SRC")/${line#@}"
        if [ -f "$imported" ]; then
          cat "$imported"
          echo
        else
          printf '%s\n' "$line"
        fi
        ;;
      *) printf '%s\n' "$line" ;;
    esac
  done < "$SRC"
  # Codex has no `paths:` support, so path-scoped rules that CLAUDE.md does not @import get inlined with frontmatter stripped.
  # Read once into a variable because a `tr | grep -q` pipe under pipefail can report SIGPIPE when grep exits early.
  SRC_LINES=$(tr -d '\r' < "$SRC")
  for rule in "$(dirname "$SRC")"/rules/*.md; do
    [ -f "$rule" ] || continue
    grep -qxF "@rules/$(basename "$rule")" <<< "$SRC_LINES" && continue
    echo
    # Buffers a leading frontmatter block and prints it back if no closing --- ever arrives, so a stray first line can't swallow the rule.
    tr -d '\r' < "$rule" | awk 'NR==1 && /^---$/ {fm=1; buf=$0 ORS; next} fm {if (/^---$/) {fm=0; buf=""} else buf = buf $0 ORS; next} {print} END {if (fm) printf "%s", buf}'
  done
} > "$OUT"

echo "Wrote $OUT ($(grep -c '' "$OUT") lines) from ${SRC/#$HOME/~}."
